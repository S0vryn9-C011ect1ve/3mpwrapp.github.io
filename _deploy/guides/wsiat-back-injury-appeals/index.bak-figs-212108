      const sevenDaysAgo = new Date(now - (7 * 24 * 60 * 60 * 1000));
      const thirtyDaysAgo = new Date(now - (30 * 24 * 60 * 60 * 1000));
      const weeklyCount = data.entries.filter(e => new Date(e.date) >= sevenDaysAgo).length;
      const monthlyCount = data.entries.filter(e => new Date(e.date) >= thirtyDaysAgo).length;

      // Never show a contradictory "0" during a naturally quiet week.
      // Prefer this week; fall back to last-30-days; link to full history.
      const countEl = document.getElementById('sticky-update-count');
      const wrap = document.getElementById('sticky-update-count-wrap');
      if (weeklyCount > 0) {
        countEl.textContent = `${weeklyCount}`;
        wrap.style.display = 'inline';
      } else if (monthlyCount > 0) {
        countEl.textContent = `${monthlyCount}`;
        document.getElementById('sticky-text').innerHTML =
          '<strong>We\'re building in public!</strong> <span id="sticky-update-count-wrap" style="display:inline"><span id="sticky-update-count">' + monthlyCount + '</span> updates in the last 30 days</span>';
      } else {
        // Genuinely quiet — honest, non-contradictory messaging.
        document.getElementById('sticky-text').innerHTML =
          '<strong>We\'re building in public!</strong> See our full progress history.';
      }
    } else {
      document.getElementById('sticky-update-count').textContent = 'several';
    }
  } catch (err) {
    console.warn('Failed to load sticky banner data:', err);
    document.getElementById('sticky-update-count').textContent = 'several';
  }
  
  // Check if banner was previously dismissed (within 7 days)
  const dismissedTime = localStorage.getItem('transparencyBannerDismissed');
  if (dismissedTime) {
    const sevenDaysAgo = Date.now() - (7 * 24 * 60 * 60 * 1000);
    if (parseInt(dismissedTime) > sevenDaysAgo) {
      document.getElementById('sticky-transparency-banner').classList.add('dismissed');
    }
  }
})();

// Dismiss banner
function dismissStickyBanner() {
  document.getElementById('sticky-transparency-banner').classList.add('dismissed');
  localStorage.setItem('transparencyBannerDismissed', Date.now().toString());
}
</script>
